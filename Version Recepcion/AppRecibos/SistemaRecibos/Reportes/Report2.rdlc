                              <Style>
                                <FontSize>8pt</FontSize>
                                <FontWeight>=IIf(Fields!STATUS.Value="R", "ExtraBold","Default")</FontWeight>
                                <Color>=IIf(Fields!STATUS.Value="R", "Black","Red")</Color>
                              </Style>
